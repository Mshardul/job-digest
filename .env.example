# Copy to .env for local runs. Never commit .env.
# In GitHub Actions, set each of these as a repository secret instead.

# --- Database ---
# Local development: a plain SQLite file.
DATABASE_URL=sqlite:///job_digest.db
# Production (Turso): set the libSQL URL here and the auth token below.
# The exact URL form is documented once the driver is confirmed (milestone 1).
TURSO_AUTH_TOKEN=

# --- Email (SMTP) ---
# Gmail: smtp.gmail.com, port 587 (STARTTLS), with a Google app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-app-password

# Who receives the daily digest.
NOTIFY_TO=you@example.com
# Who receives operator alerts. Falls back to NOTIFY_TO when empty.
ALERT_TO=

# --- Profile ---
# Locally, Job Digest reads profile.yaml. In GitHub Actions, the whole
# profile YAML is stored in the JOB_DIGEST_PROFILE secret.
# JOB_DIGEST_PROFILE=

# --- Optional setting overrides (defaults live in code) ---
# JOB_DIGEST_ALERTS_ENABLED=true
# JOB_DIGEST_DB_WARMUP_ON_START=false
# JOB_DIGEST_RECENT_DAYS=7
